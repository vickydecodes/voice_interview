# MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=ai_interview_simulator

# JWT Authentication
JWT_SECRET=ai-interview-simulator-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM Provider Configuration (mock or openrouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Verified Active Free Models on OpenRouter:
# 1. nvidia/nemotron-3.5-lightning:free (Recommended: High-speed conversational voice & JSON)
# 2. nvidia/nemotron-3-ultra-550b-a55b:free (Flagship 550B, deep technical & architecture questions)
# 3. cohere/north-mini-code:free (High accuracy technical coding & framework evaluation)
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_INTERVIEW_MODEL=nvidia/nemotron-3.5-lightning:free

# App Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://localhost:5173","http://localhost:3000"]
