# MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=ai_interview_simulator

# JWT Authentication
JWT_SECRET=ai-interview-simulator-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM Provider Configuration (mock or openrouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_INTERVIEW_MODEL=minimax/minimax-m3.1-flash:free

# App Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://localhost:5173","http://localhost:3000"]
